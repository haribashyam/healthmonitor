rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{testId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().userId == userId
        && incoming().email is string
        && incoming().email.size() <= 200;
      allow update: if isOwner(userId)
        && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // Biometric & Health telemetry subcollection
      match /metrics/{metricId} {
        allow get: if isOwner(userId) && isValidId(metricId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(metricId)
          && incoming().userId == userId
          && incoming().id is string
          && incoming().date is string;
        allow update: if isOwner(userId) && isValidId(metricId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(metricId);
      }

      // AI Adaptive Plans subcollection
      match /plans/{planId} {
        allow get: if isOwner(userId) && isValidId(planId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(planId)
          && incoming().userId == userId
          && incoming().planName is string;
        allow update: if isOwner(userId) && isValidId(planId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(planId);
      }

      // Laboratory biomarker panels subcollection
      match /labReports/{reportId} {
        allow get: if isOwner(userId) && isValidId(reportId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reportId)
          && incoming().userId == userId
          && incoming().title is string;
        allow update: if isOwner(userId) && isValidId(reportId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(reportId);
      }

      // Google Workspace integration audit logs
      match /workspaceLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId)
          && incoming().userId == userId
          && incoming().actionType is string;
        allow update: if isOwner(userId) && isValidId(logId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Medications & Supplements subcollection
      match /supplements/{suppId} {
        allow get: if isOwner(userId) && isValidId(suppId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(suppId)
          && incoming().userId == userId
          && incoming().name is string;
        allow update: if isOwner(userId) && isValidId(suppId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(suppId);
      }

      // Health Experiments & N=1 Trials subcollection
      match /experiments/{expId} {
        allow get: if isOwner(userId) && isValidId(expId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(expId)
          && incoming().userId == userId
          && incoming().title is string;
        allow update: if isOwner(userId) && isValidId(expId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(expId);
      }

      // Injury & Mobility Rehabilitation subcollection
      match /injuries/{injuryId} {
        allow get: if isOwner(userId) && isValidId(injuryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(injuryId)
          && incoming().userId == userId
          && incoming().joint is string;
        allow update: if isOwner(userId) && isValidId(injuryId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(injuryId);
      }

      // Emergency & Medical ID subcollection
      match /emergencyCare/{recordId} {
        allow get: if isOwner(userId) && isValidId(recordId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId)
          && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(recordId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      // Strength Training & 1RM subcollection
      match /strengthLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId)
          && incoming().userId == userId
          && incoming().exerciseName is string;
        allow update: if isOwner(userId) && isValidId(logId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}

