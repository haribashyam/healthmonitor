rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Helper Functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for User Profile
    function isValidUserProfile(data, userId) {
      return data.userId == userId
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 200
        && (data.role == 'user' || data.role == 'clinician' || data.role == 'admin');
    }

    // Validation for User Partitioned Sub-collections
    function isValidBiomarker(data, userId) {
      return data.userId == userId
        && data.id is string
        && data.name is string
        && data.value is string
        && data.unit is string
        && data.date is string;
    }

    function isValidJournal(data, userId) {
      return data.userId == userId
        && data.id is string
        && data.date is string
        && data.energyLevel is number
        && data.stressLevel is number;
    }

    function isValidActivity(data, userId) {
      return data.userId == userId
        && data.id is string
        && data.title is string
        && data.durationMinutes is number
        && data.calories is number
        && data.date is string;
    }

    function isValidGoal(data, userId) {
      return data.userId == userId
        && data.id is string
        && data.title is string
        && data.category is string
        && data.targetValue is number
        && data.unit is string;
    }

    // Root Users Collection: Partitioned Strictly by UID
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket enumeration forbidden
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      // Sub-collection: Biomarkers (Strictly Partitioned by UID)
      match /biomarkers/{biomarkerId} {
        allow get: if isOwner(userId) && isValidId(biomarkerId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(biomarkerId) && isValidBiomarker(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(biomarkerId) && isValidBiomarker(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(biomarkerId);
      }

      // Sub-collection: Health Journal (Strictly Partitioned by UID)
      match /journal/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(entryId) && isValidJournal(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(entryId) && isValidJournal(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      // Sub-collection: Activities (Strictly Partitioned by UID)
      match /activities/{activityId} {
        allow get: if isOwner(userId) && isValidId(activityId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(activityId) && isValidActivity(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(activityId) && isValidActivity(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(activityId);
      }

      // Sub-collection: Goals (Strictly Partitioned by UID)
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId) && isValidGoal(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(goalId) && isValidGoal(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(goalId);
      }
    }

    // Health / Connection Test Doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
