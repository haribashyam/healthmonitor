{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal identity and role information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "clinician", "admin"] },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["userId", "email", "role"]
    },
    "BiomarkerRecord": {
      "title": "BiomarkerRecord",
      "description": "Clinical and lab biomarker datapoint",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "value": { "type": "string" },
        "unit": { "type": "string" },
        "referenceRange": { "type": "string" },
        "status": { "type": "string", "enum": ["optimal", "normal", "borderline", "abnormal"] },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["id", "userId", "name", "value", "unit", "status", "category", "date"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Subjective daily recovery, mood, energy, and symptom journal entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "energyLevel": { "type": "number" },
        "stressLevel": { "type": "number" },
        "muscleSoreness": { "type": "number" },
        "notes": { "type": "string" },
        "tags": { "type": "array" }
      },
      "required": ["id", "userId", "date", "energyLevel", "stressLevel"]
    },
    "ActivityRecord": {
      "title": "ActivityRecord",
      "description": "Fitness workout and endurance activity record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "calories": { "type": "number" },
        "avgHeartRate": { "type": "number" },
        "maxHeartRate": { "type": "number" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["id", "userId", "title", "type", "durationMinutes", "calories", "date"]
    },
    "HealthGoal": {
      "title": "HealthGoal",
      "description": "User specific target physiological or lifestyle goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "unit": { "type": "string" },
        "targetDate": { "type": "string" },
        "progressPercent": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "title", "category", "targetValue", "unit"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile document partitioned strictly by auth UID"
    },
    "/users/{userId}/biomarkers/{biomarkerId}": {
      "schema": "BiomarkerRecord",
      "description": "User-partitioned collection of blood and clinical biomarkers"
    },
    "/users/{userId}/journal/{entryId}": {
      "schema": "JournalEntry",
      "description": "User-partitioned health and recovery daily journal logs"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "ActivityRecord",
      "description": "User-partitioned workout and endurance telemetry activities"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "HealthGoal",
      "description": "User-partitioned target health and biomarker goals"
    }
  }
}
